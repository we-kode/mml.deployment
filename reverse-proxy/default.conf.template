limit_req_zone ${REQUEST_MODE} zone=ratelimit:${RIP_CACHE} rate=${RPS_LIMIT}r/s;

# upgrade the connection of websocket requests to the hubs
map $http_upgrade $mml_connection_upgrade {
    default upgrade;
    ''      close;
}

# the tokens of share links are part of the path and must not be logged
map $uri $mml_access_log {
    ~*^/media/s/  0;
    default 1;
}

server {
    # listen, tls and client ip configuration generated by 15-mml-listen.sh depending on PROXY_TLS
    include /etc/nginx/conf.d/mml-listen.inc;

    # turn off version of nginx and set limit for header size
    server_tokens off;
    client_header_buffer_size 1k;
    client_body_buffer_size 1k;
    client_max_body_size ${FILE_UPLOAD_LIMIT};

    # allowed request methods
    if ($request_method !~ ^(GET|OPTIONS|POST|DELETE)$ ) {
        return 444;
    }

    # Block download agents
    if ($http_user_agent ~* LWP::Simple|BBBike|wget) {
        return 403;
    }

    # Block some robots
    if ($http_user_agent ~* msnbot|scrapbot) {
        return 403;
    }

    # logging to files in PROXY_LOGS instead of the console. The error log is set globally by 15-mml-listen.sh.
    access_log /var/log/nginx/mml/access.log combined buffer=32k flush=5s if=$mml_access_log;
    gzip on;

    ## secure headers
    # anti clickjacking
    add_header X-Frame-Options "SAMEORIGIN";
    # hsts
    add_header Strict-Transport-Security "max-age=31536000; includeSubdomains; preload";
    # CSP and X-XSS-Protection
    add_header Content-Security-Policy "default-src 'self' http: https: data: blob: 'unsafe-inline' 'unsafe-eval'" always;
    add_header X-XSS-Protection "1; mode=block";
    # disable Content-Type-Sniffing
    add_header X-Content-Type-Options nosniff;

    # internal Docker DNS with 30s cache
    resolver 127.0.0.11 valid=30s;

    ## proxy settings of all services
    limit_req zone=ratelimit burst=${RBURST_LIMIT} nodelay;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $mml_connection_upgrade;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $mml_forwarded_proto;

    ## Identity-Service: api, openid configuration and client registration hub
    location ~* ^/(\.well-known|api/v[^/]+/identity|hub/client)(/|$) {
        set $upstream ${IDENTITY_API_ADDRESS}:${IDENTITY_API_PORT};
        proxy_pass $upstream;
    }

    ## Media-Service: all other requests, e.g. api, share pages and federation hub
    location / {
        set $upstream ${MEDIA_API_ADDRESS}:${MEDIA_API_PORT};
        proxy_pass $upstream;
        # stream large downloads and records without buffering
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }
}
